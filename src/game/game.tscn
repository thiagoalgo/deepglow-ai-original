[gd_scene format=3]

[ext_resource type="Script" path="res://src/game/game.gd" id="1_game"]
[ext_resource type="Resource" path="res://data/pieces/catalog.tres" id="2_catalog"]
[ext_resource type="PackedScene" path="res://src/board/board.tscn" id="3_board"]
[ext_resource type="Script" path="res://src/core/state_machine/state_machine.gd" id="4_sm"]
[ext_resource type="Script" path="res://src/game/states/setup_state.gd" id="5_setup"]
[ext_resource type="Script" path="res://src/game/states/player_turn_state.gd" id="6_turn"]

[node name="Game" type="Node2D"]
script = ExtResource("1_game")
catalog = ExtResource("2_catalog")

[node name="Board" parent="." instance=ExtResource("3_board")]
unique_name_in_owner = true

[node name="StateMachine" type="Node" parent="." node_paths=PackedStringArray("initial_state")]
unique_name_in_owner = true
script = ExtResource("4_sm")
initial_state = NodePath("Setup")

[node name="Setup" type="Node" parent="StateMachine"]
script = ExtResource("5_setup")

[node name="PlayerTurn" type="Node" parent="StateMachine"]
script = ExtResource("6_turn")
