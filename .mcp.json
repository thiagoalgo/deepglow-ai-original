{
    "mcpServers": {
        "pixellab": {
            "type": "http",
            "url": "https://api.pixellab.ai/mcp",
            "headers": {
                "Authorization": "Bearer ${PIXELLAB_API_KEY}"
            }
        },
        "godot": {
            "command": "npx",
            "args": ["-y", "@coding-solo/godot-mcp"],
            "env": {
                "GODOT_PATH": "${GODOT_PATH:-/Applications/Godot.app/Contents/MacOS/Godot}"
            }
        }
    }
}
